# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth ---
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Postgres ---
DATABASE_URL=postgres://trackrunner:trackrunner@localhost:5432/trackrunner

# --- Persistence worker ---
FLUSH_INTERVAL_MS=10000
