# --- Server ---
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# Comma-separated browser origins. Native apps normally have no Origin header.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth ---
JWT_SECRET=development-only-secret-change-before-production
JWT_EXPIRES_IN=7d

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Postgres ---
DATABASE_URL=postgres://trackrunner:trackrunner@localhost:5432/trackrunner

# --- Persistence worker ---
FLUSH_INTERVAL_MS=10000
FIREBASE_SERVICE_ACCOUNT_PATH=.secrets/firebase-service-account.json
# Production: set FIREBASE_SERVICE_ACCOUNT_JSON as a secret environment value.
